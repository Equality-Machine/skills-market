{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-market.dev/schema/v1.json",
  "title": "Skills Market Registry",
  "type": "object",
  "required": ["name", "version", "skills", "updatedAt"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "$ref": "#/definitions/author" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/definitions/skill" }
    }
  },
  "definitions": {
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "install": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["npx", "git", "local"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "command": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["github", "url", "local"] },
        "repo": { "type": "string" },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "author",
        "category",
        "tags",
        "install",
        "source",
        "createdAt",
        "downloads",
        "verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "minLength": 2,
          "maxLength": 64
        },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string", "minLength": 10, "maxLength": 500 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "author": { "$ref": "#/definitions/author" },
        "category": {
          "type": "string",
          "enum": [
            "demo",
            "development",
            "design",
            "devops",
            "writing",
            "data",
            "security",
            "productivity",
            "other"
          ]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10
        },
        "install": { "$ref": "#/definitions/install" },
        "source": { "$ref": "#/definitions/source" },
        "homepage": { "type": "string" },
        "license": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "downloads": { "type": "integer", "minimum": 0 },
        "verified": { "type": "boolean" }
      }
    }
  }
}

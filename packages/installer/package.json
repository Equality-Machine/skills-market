{
  "name": "skills-market",
  "version": "0.1.0",
  "description": "Claude Code skills marketplace — install, sync, and mirror community skills via git.",
  "type": "module",
  "license": "MIT",
  "author": "Vincent Cheng <nx_meteor@163.com>",
  "homepage": "https://github.com/Equality-Machine/skills-market#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Equality-Machine/skills-market.git",
    "directory": "packages/installer"
  },
  "bugs": {
    "url": "https://github.com/Equality-Machine/skills-market/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "marketplace",
    "installer",
    "anthropic",
    "mcp"
